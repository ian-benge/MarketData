# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=replace-with-long-random-secret

# Feature flags
ALLOW_MOCK_PROVIDERS=true
DEMO_MODE=true

# Supabase
# Leave blank for the local fixture demo. Setting both URL + anon key disables demo cookie auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BOOTSTRAP_ADMIN_EMAIL=

# Market / news / macro (legacy + secondary)
# Finnhub: delayed quotes/news; may remain MARKET_DATA_FALLBACK or legacy market slot
FINNHUB_API_KEY=
# Free secondary earnings calendar. Do not commit the key.
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
# Optional licensed CME FedWatch REST bearer. Blank uses public delayed ZQ + NY Fed.
CME_FEDWATCH_ACCESS_TOKEN=
# Optional. Default when token is set: https://markets.api.cmegroup.com/fedwatch_rt/v1
CME_FEDWATCH_API_BASE=
# Optional. Blank uses official Fed/BLS/SEC plus CNBC markets RSS.
NEWS_RSS_FEEDS=
# SEC requires a descriptive User-Agent (app + contact). Falls back to NEXT_PUBLIC_APP_URL.
EDGAR_USER_AGENT=

# -----------------------------------------------------------------------------
# Realtime market-data core (see docs/market-data-architecture.md)
# Shared production real-time is NOT activated until owner checklist is complete.
# -----------------------------------------------------------------------------

# Primary provider: alpaca | massive | finnhub | mock (mock only with ALLOW_MOCK_PROVIDERS, non-prod)
MARKET_DATA_PRIMARY=alpaca
# Fallback when primary fails: massive | finnhub | none
MARKET_DATA_FALLBACK=none

# License scope is a config enum — not proof of entitlement.
# single_user_development | internal_team | redistributable
MARKET_DATA_LICENSE_SCOPE=single_user_development
# Operational guardrail only: owner verified current provider terms for intended use.
# NOT legal proof of a license. Required true for shared production use (with team/redistributable scope).
MARKET_DATA_LICENSE_ACKNOWLEDGED=false

# Adaptive refresh cadence (seconds) — driven by existing /api/cron/tick
MARKET_DATA_REFRESH_OPEN_SECONDS=60
MARKET_DATA_REFRESH_EXTENDED_SECONDS=120
MARKET_DATA_REFRESH_CLOSED_SECONDS=300
# Cache age before observations are labeled stale
MARKET_DATA_STALE_AFTER_SECONDS=180
# Cap on refresh universe size (index/sector ETFs + watchlist + report symbols)
MARKET_DATA_MAX_UNIVERSE_SIZE=80

# Alpaca Market Data — https://docs.alpaca.markets/  |  plans: https://alpaca.markets/data
# IEX = single-exchange realtime (default). SIP only when account is entitled.
# Never treat IEX as SIP/NBBO/full-market. Redistribution often restricted — verify terms.
ALPACA_DATA_KEY_ID=
ALPACA_DATA_SECRET_KEY=
ALPACA_STOCK_FEED=iex
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Massive (formerly Polygon.io) — https://massive.com/docs/  |  https://massive.com/pricing
# Adapter inactive without a key. Individual plans are not assumed team/redistribution-licensed.
MASSIVE_API_KEY=
MASSIVE_API_BASE_URL=https://api.massive.com

# AI providers — Anthropic and Gemini, or Vercel AI Gateway. No OpenAI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_DEFAULT_PROVIDER=anthropic
# Preferred: Vercel AI Gateway (OIDC via `vercel env pull`, or a gateway key)
AI_GATEWAY_API_KEY=
DESK_INTEL_MODEL_FAST=google/gemini-3.7-flash
DESK_INTEL_MODEL_STRONG=anthropic/claude-sonnet-5
DESK_INTEL_ENABLED=true
DESK_INTEL_IN_FIXTURES=false

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="IB Market Data <reports@example.com>"

# SnapTrade (optional, server-only) — read-only brokerage linking for Positions
# https://docs.snaptrade.com/docs/getting-started
# Never expose SNAPTRADE_CONSUMER_KEY to the client (no NEXT_PUBLIC_ prefix).
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Optional storage overrides (defaults to Supabase Storage)
STORAGE_BUCKET=reports

# Optional firm UUID override (must be a UUID if set). Seeded Research Desk:
# a0000000-0000-4000-8000-000000000001 — leave blank to unset.
FIRM_ID=

# Cursor SDK page improvement harness (CLI only — not read by Next.js)
# User or service-account key from https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
